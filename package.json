{
  "name": "pdf-studio",
  "version": "1.0.0",
  "description": "PDF Studio - a desktop PDF editor for Windows (edit text, sign, annotate, organize pages)",
  "main": "main.js",
  "author": "Saeein",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "build": {
    "appId": "com.pdfstudio.app",
    "productName": "PDF Studio",
    "files": ["main.js", "preload.js", "renderer/**/*", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "fileAssociations": [{ "ext": "pdf", "name": "PDF Document", "role": "Editor" }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
